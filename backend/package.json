{
  "name": "@figma/my-make-file-backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "vite build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js",
    "test:auth-integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js tests/auth.integration.test.js",
    "test:email-integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js tests/testDriveEmail.integration.test.js",
    "test:test-drive-emails": "node tests/testDriveEmailPipeline.manual.js",
    "cleanup:car-images": "node scripts/cleanupStaleCarImages.js --dry-run",
    "cleanup:car-images:execute": "node scripts/cleanupStaleCarImages.js --execute",
    "cleanup:car-images:job": "node -e \"import('./jobs/cleanupStaleCarImagesJob.js').then(async (m) => console.log(JSON.stringify(await m.runCleanupStaleCarImagesJob(), null, 2)))\"",
    "test:car-image-cleanup": "node tests/carImageCleanup.manual.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pdfmake": "^0.3.11",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react-router-dom": "^7.18.3",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}

# Backend runtime
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Sprint 9 exchange-rate integration
# Server

# Database / Auth
DATABASE_URL=postgresql://database_user:replace_me@localhost:5432/cardealership_dev
# DATABASE_SSL=require  # verified TLS for managed databases; localhost defaults to no TLS
# Schema and indexes are provisioned explicitly with npm run db:init.

# Email Provider
# Supported values: pending, nodemailer, sendgrid
EMAIL_PROVIDER=pending

# Shared Email Settings
EMAIL_FROM=no-reply@example.com
EMAIL_REPLY_TO=support@example.com

# Nodemailer Settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SECURE=false

# SendGrid Settings
SENDGRID_API_KEY=

# Storage Cleanup
STORAGE_PROVIDER=pending
IMAGE_STORAGE_PROVIDER=pending
CLEANUP_STORAGE_DELETE_ENABLED=false

# Cloudinary Storage
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Scheduled Cleanup Job
CLEANUP_CRON_ENABLED=false
CLEANUP_CRON_SCHEDULE=0 2 * * *
CLEANUP_DRY_RUN=true
CLEANUP_OLDER_THAN_DAYS=30
CLEANUP_LIMIT=100
CLEANUP_STATUSES=Draft,Deleted

# Sprint 9 Exchange Rates
EXCHANGE_RATE_PROVIDER=disabled
EXCHANGE_RATE_BASE_CURRENCY=UGX
EXCHANGE_RATE_SUPPORTED_CURRENCIES=UGX,USD,EUR,GBP,KES
EXCHANGE_RATE_REFRESH_INTERVAL_MS=3600000
EXCHANGE_RATE_REQUEST_TIMEOUT_MS=5000
EXCHANGE_RATE_CACHE_TTL_MS=7200000
EXCHANGE_RATE_MOCK_SCENARIO=success

# Sprint 9 bulk image uploads
# Sprint 9 Bulk Image Upload
BULK_IMAGE_UPLOAD_FIELD_NAME=images
BULK_IMAGE_UPLOAD_MAX_FILES=10
BULK_IMAGE_UPLOAD_MAX_FILE_SIZE_BYTES=5242880
BULK_IMAGE_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
BULK_IMAGE_UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp
CLOUDINARY_CAR_IMAGE_FOLDER=car-dealership/cars
NODE_ENV=development
# Tests require a separate URL and NODE_ENV=test
# TEST_DATABASE_URL=postgresql://database_user:replace_me@localhost:5432/cardealership_test
# Staging only: configure exact name and deployment identifier in Render
# STAGING_DATABASE_NAME=cardealership_s17_staging
# STAGING_DEPLOYMENT_ID=s17-panda-staging
# DATABASE_NETWORK=render-private  # Render internal URL only, explicitly encrypted
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173
DB_POOL_MAX=5
SITE_URL=http://localhost:5173
DB_CONNECT_TIMEOUT_MS=10000
CHAT_RETENTION_DAYS=30
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_WEBP_QUALITY=80
IMAGE_TEST_CLEANUP=true
INDEX_DB_MAX_RETRIES=5
INDEX_DB_RETRY_DELAY_MS=2000

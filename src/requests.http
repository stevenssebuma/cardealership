Content-Type: multipart/form-data; boundary=CarImageBoundary

--CarImageBoundary
Content-Disposition: form-data; name="carId"

1
--CarImageBoundary
Content-Disposition: form-data; name="imageType"

primary
--CarImageBoundary
Content-Disposition: form-data; name="image"; filename="toyota-car.jpg"
Content-Type: image/jpeg

< C:/Users/admin/Downloads/toyota-vehicle.jpg
--CarImageBoundary--



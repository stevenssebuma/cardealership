############################################################
# PRIMARY IMAGE REPLACEMENT TEST
############################################################

### REPLACE EXISTING PRIMARY IMAGE
#
# EXPECT:
# HTTP 201
#
# The new image must be uploaded and saved successfully
# before the existing primary is removed.
#
# EXPECT RESPONSE:
# database.is_primary = true
# database.image_type = primary
# database.cloudinary_public_id is populated
#
# primaryReplacement.changed = true
# primaryReplacement.newPrimaryImageId is populated
# primaryReplacement.removedOldPrimaryIds contains old primary
#
POST {{baseUrl}}/api/cars/upload
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=PrimaryReplacementBoundary

--PrimaryReplacementBoundary
Content-Disposition: form-data; name="carId"

1
--PrimaryReplacementBoundary
Content-Disposition: form-data; name="imageType"

primary
--PrimaryReplacementBoundary
Content-Disposition: form-data; name="image"; filename="toyota-vehicle.jpg"
Content-Type: image/jpeg

< C:/Users/admin/Downloads/toyota-vehicle.jpg
--PrimaryReplacementBoundary--


### VERIFY CAR AFTER PRIMARY REPLACEMENT
#
# EXPECT:
# HTTP 200
# New primary image should be returned for car 1.
#
GET {{baseUrl}}/api/cars/1
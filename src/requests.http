############################################################
# TASK 1 — DYNAMIC VEHICLE PRICING MATRIX ENGINE
############################################################

### TASK 1.1 — GET ALL CARS WITH DEAL BADGES
#
# EXPECT:
# HTTP 200
# every vehicle should contain a deal object
#
GET {{baseUrl}}/api/cars


### TASK 1.2 — GET SINGLE CAR AND RECORD VIEW
#
# EXPECT:
# HTTP 200
# deal.totalViews should increase
#
GET {{baseUrl}}/api/cars/1


### TASK 1.3 — GET SINGLE CAR AGAIN
#
# EXPECT:
# totalViews should increase again
#
GET {{baseUrl}}/api/cars/1


### TASK 1.4 — UPDATE CAR PRICE
#
# EXPECT:
# HTTP 200
# oldPrice should contain previous price
# deal.priceDropPercentage should be greater than 0
# badge should normally become Price Dropped
#
PATCH {{baseUrl}}/api/cars/1/price
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "price": 260000000
}


### TASK 1.5 — GET PRICE HISTORY
#
# EXPECT:
# HTTP 200
# history should contain old_price and new_price
#
GET {{baseUrl}}/api/cars/1/price-history
Authorization: Bearer {{adminToken}}


### TASK 1.6 — GET CAR AFTER PRICE CHANGE
#
# EXPECT:
# price = 260000000
# previousPrice should contain previous value
# priceDropPercentage should be calculated
#
GET {{baseUrl}}/api/cars/1


############################################################
# TASK 2 — BULK MULTI-IMAGE CAR BATCH UPLOADER
############################################################
#
# REQUIREMENTS:
#
# - Admin authentication
# - Up to 10 images
# - 15 MB max per image
# - JPEG / PNG / WEBP / HEIC / HEIF
# - Sharp optimization
# - WebP output
# - Cloudinary upload
# - PostgreSQL mapping
# - sort_order
# - bounded concurrency
# - partial failure handling
#
############################################################


### TASK 2.1 — BATCH UPLOAD TWO CAR IMAGES
#
# IMPORTANT:
#
# Change these two local paths if your image filenames differ.
#
# EXPECT:
#
# HTTP 201
#
# requestedCount = 2
# successfulCount = 2
# failedCount = 0
# allSucceeded = true
#
POST {{baseUrl}}/api/cars/1/images/batch
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=CarBatchBoundary

--CarBatchBoundary
Content-Disposition: form-data; name="primaryIndex"

0
--CarBatchBoundary
Content-Disposition: form-data; name="imageType"

general
--CarBatchBoundary
Content-Disposition: form-data; name="images"; filename="toyota-vehicle.jpg"
Content-Type: image/jpeg

< C:/Users/admin/Downloads/toyota-vehicle.jpg
--CarBatchBoundary
Content-Disposition: form-data; name="images"; filename="toyota-hind.jpg"
Content-Type: image/jpeg

< C:/Users/admin/Downloads/toyota_hind.jpg
--CarBatchBoundary--


### TASK 2.2 — VERIFY IMAGES THROUGH CAR API
#
# EXPECT:
#
# GET succeeds
# uploaded images should now belong to car 1
#
GET {{baseUrl}}/api/cars/1


### TASK 2.3 — BATCH UPLOAD WITHOUT AUTHENTICATION
#
# EXPECT:
# HTTP 401
#
POST {{baseUrl}}/api/cars/1/images/batch
Content-Type: multipart/form-data; boundary=UnauthorizedBatchBoundary

--UnauthorizedBatchBoundary
Content-Disposition: form-data; name="images"; filename="toyota-vehicle.jpg"
Content-Type: image/jpeg

< C:/Users/admin/Downloads/toyota-vehicle.jpg
--UnauthorizedBatchBoundary--


### TASK 2.4 — CUSTOMER TRIES BATCH UPLOAD
#
# EXPECT:
# HTTP 403
#
POST {{baseUrl}}/api/cars/1/images/batch
Authorization: Bearer {{customerToken}}
Content-Type: multipart/form-data; boundary=CustomerBatchBoundary

--CustomerBatchBoundary
Content-Disposition: form-data; name="images"; filename="toyota-vehicle.jpg"
Content-Type: image/jpeg

< C:/Users/admin/Downloads/toyota-vehicle.jpg
--CustomerBatchBoundary--


### TASK 2.5 — INVALID CAR ID
#
# EXPECT:
# HTTP 404
# code = CAR_NOT_FOUND
#
POST {{baseUrl}}/api/cars/99999/images/batch
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=InvalidCarBatchBoundary

--InvalidCarBatchBoundary
Content-Disposition: form-data; name="images"; filename="toyota-vehicle.jpg"
Content-Type: image/jpeg

